                    "slug": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "name",
                    "slug"
                ],
                "title": "CategoryRequest"
            },
            "CategoryResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "slug"
                ],
                "title": "CategoryResource"
            },
            "Order": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "user_id": {
                        "type": "integer"
                    },
                    "total": {
                        "type": "string"
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "user_id",
                    "total",
                    "created_at",
                    "updated_at"
                ],
                "title": "Order"
            },
            "Product": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "category_id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "price": {
                        "type": "string"
                    },
                    "stock": {
                        "type": "integer"
                    },
                    "image": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "category_id",
                    "name",
                    "slug",
                    "description",
                    "price",
                    "stock",
                    "image",
                    "created_at",
                    "updated_at"
                ],
                "title": "Product"
            },
            "ProductResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "price": {
                        "type": "string"
                    },
                    "stock": {
                        "type": "integer"
                    },
                    "image": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "category": {
                        "$ref": "#/components/schemas/CategoryResource"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "slug",
                    "description",
                    "price",
                    "stock",
                    "image"
                ],
                "title": "ProductResource"
            },
            "StoreProductRequest": {
                "type": "object",
                "properties": {
                    "category_id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "slug": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "stock": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "image": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "category_id",
                    "name",
                    "slug",
                    "price"
                ],
                "title": "StoreProductRequest"
            },
            "UpdateProductRequest": {
                "type": "object",
